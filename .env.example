# Backend API base URL — already includes /api/v1
# Used for ISR data fetching and to verify the admin JWT on /api/revalidate (GET /users/me)
API_URL=http://localhost:3000/api/v1

# Origin of the admin CMS dashboard SPA — allowed by CORS to call POST /api/revalidate
CMS_ORIGIN=http://localhost:5173

# NextAuth secret
NEXTAUTH_SECRET=your-nextauth-secret

# NOTE: REVALIDATE_SECRET is no longer used by /api/revalidate.
# The route now authorizes via the admin's JWT (Authorization: Bearer <token>).
