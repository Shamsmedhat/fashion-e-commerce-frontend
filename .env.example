# Backend API base URL — already includes /api/v1
# Local backend runs on :3000 (in its repo: `yarn dev`, or `yarn dev:memory` for a seeded throwaway database)
API_URL=http://localhost:3000/api/v1

# NextAuth — the storefront runs on :3001 locally (`yarn dev -p 3001`)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Optional. Origins of the admin dashboard allowed to call POST /api/revalidate (comma-separated).
# Defaults to local development and the deployed dashboard.
# CMS_ORIGIN=http://localhost:5173
